# Modèle de configuration de Vigie.
#
#   cp .env.example .env     puis remplir ce qui est utile ; chmod 600 .env
#
# Le fichier .env n'est JAMAIS versionné. Toutes les valeurs sont facultatives : une variable
# laissée vide prend sa valeur par défaut, et une couche qui demande une clé vide est désactivée.
# Les valeurs contenant des caractères spéciaux se mettent entre apostrophes.
# Description de chaque variable : docs/deploiement.md

# --- Lues par compose.yaml (côté hôte) ---------------------------------------------------------

# Adresse de la machine sur laquelle le port est publié (127.0.0.1 : la machine seule).
BIND_ADDRESS=
# Port publié (8787).
PORT=
# Utilisateur:groupe propriétaire de data/ et archive/ (1000:1000).
RUN_AS=
# Dossiers montés sur /data et /archive (./data et ./archive).
DATA_PATH=
ARCHIVE_PATH=

# --- Clés et comptes (secrets) -----------------------------------------------------------------

# Couche « Bateaux » : clé gratuite de aisstream.io. Vide : couche désactivée.
AISSTREAM_API_KEY=
# Couche « Qualité de l'air » : compte gratuit Atmo Data. Vides : couche désactivée.
ATMO_USERNAME=
ATMO_PASSWORD=
# Métro, RER, Transilien et tramways d'Île-de-France : clé gratuite de la plateforme PRIM
# (Île-de-France Mobilités). Vide : ces réseaux sont ignorés.
IDFM_PRIM_API_KEY=

# --- Île-de-France (transmis au conteneur par compose.yaml) -----------------------------------

# Modes suivis (metro,tram,train,cable). Ajouter « bus » : voir docs/couches.md avant de l'activer.
IDFM_MODES=
# Intervalle du relevé SIRI en secondes (180, minimum 120).
IDFM_INTERVALLE_S=
# Budget de mémoire du modèle d'Île-de-France, en Mo (100).
IDFM_MEMOIRE_MO=

# --- Autres réglages du serveur ----------------------------------------------------------------
# Pas transmis par compose.yaml : pour les utiliser dans Docker, les ajouter à sa section
# « environment ». Sans Docker, ils se passent directement à `cargo run`.

# Jours d'historique conservés (7) et jours d'archive brute du flux SNCF (180 ; 0 = sans limite).
HISTORIQUE_JOURS=
ARCHIVE_SNCF_JOURS=
# Niveau des journaux (info,tower_http=warn).
RUST_LOG=
# Jeux de tuiles à mettre en service, séparés par des virgules (tous).
TUILES_JEUX=
# Si défini : efface la source d'un jeu de tuiles après sa fabrication.
TUILES_EFFACER_SOURCES=
# Adresse du zip des carreaux de population de l'INSEE (millésime 2019).
INSEE_CARREAUX_URL=
# Couverture mobile, essai réduit : opérateurs (OF,SFR0,BOUY,FREE), technologies (4g,voix), départements.
ARCEP_OPERATEURS=
ARCEP_TECHNOS=
ARCEP_DEPARTEMENTS=
# Si défini : garde les archives 7z de l'ARCEP.
ARCEP_GARDER_SOURCES=
# Isochrones : « non » désactive une source (ISO_CARS_TER, ISO_IDF, ISO_CARS_REGIONAUX).
ISO_CARS_TER=
ISO_IDF=
ISO_CARS_REGIONAUX=
# Cache des GTFS régionaux en Mo (800) et budget de mémoire des cars régionaux en Mo (80).
ISO_CACHE_MO=
ISO_MEMOIRE_MO=
# Adresse du GTFS d'Île-de-France (https uniquement ; défaut : GTFS public d'Île-de-France Mobilités).
IDFM_GTFS_URL=
# Positions estimées des bus, trams et métros : « non » les désactive. Décalage d'horloge pour les essais (0).
TRANSPORTS_ESTIMES=
TRANSPORTS_DECALAGE_S=
