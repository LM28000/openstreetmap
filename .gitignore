# Dépendances et builds
node_modules/
dist/
target/
target-*/

# Fichiers locaux (secrets compris : clés et comptes ne sont jamais versionnés)
.env
.env.*
!.env.example
*.local
.DS_Store

# Données téléchargées (volumineuses, jamais versionnées) : seulement celles de la racine,
# pas les petites données embarquées dans le site (web/src/data).
/data/

# Archives du temps réel (serveur maison)
/archive/

# Archives de tuiles et captures de mesure produites en local
*.pmtiles
perf/*.png

# Configuration locale de Claude Code et copies de travail
.claude/
